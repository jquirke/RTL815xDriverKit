// RTL8159Driver.iig
// Personality A: USB config selector (IOService)
//
// Matches IOUSBHostDevice (VID=0x0BDA, PID=0x815A).
// Opens the device, selects Config 1 (vendor-specific), and keeps the session
// open to prevent reversion to Config 2 (NCM, matched by com.apple.driver.usb.cdc.ncm).

#ifndef RTL8159Driver_h
#define RTL8159Driver_h

#include <Availability.h>
#include <DriverKit/IOService.iig>

struct RTL8159Driver_IVars;

class RTL8159Driver: public IOService
{
public:
    virtual bool
    init() override;

    virtual void
    free() override;

    virtual kern_return_t
    Start(IOService * provider) override;

    virtual kern_return_t
    Stop(IOService * provider) override;
};

#endif /* RTL8159Driver_h */
